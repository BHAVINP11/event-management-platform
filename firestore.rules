rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getCurrentUserId() {
      return request.auth.uid;
    }

    function isOwnProfile(userId) {
      return isAuthenticated() && getCurrentUserId() == userId;
    }

    // Membership IDs are `${resourceId}_${userId}`. This exact convention is
    // shared with src/repositories/membershipIds.ts.
    function isActiveOrganizationMember(organizationId) {
      let membershipPath = /databases/$(database)/documents/organizationMembers/$(organizationId + "_" + request.auth.uid);
      return isAuthenticated() &&
        exists(membershipPath) &&
        get(membershipPath).data.status == "active" &&
        get(membershipPath).data.organizationId == organizationId &&
        get(membershipPath).data.userId == request.auth.uid;
    }

    function isActiveEventMember(eventId) {
      let membershipPath = /databases/$(database)/documents/eventMembers/$(eventId + "_" + request.auth.uid);
      return isAuthenticated() &&
        exists(membershipPath) &&
        get(membershipPath).data.status == "active" &&
        get(membershipPath).data.eventId == eventId &&
        get(membershipPath).data.userId == request.auth.uid;
    }

    // Guest visibility scoping. Assumes isActiveEventMember(eventId) is
    // already true. Owner/planner/family/staff/viewer see every guest (Step
    // 12 does not scope Family yet — see docs/guests.md); a couple member
    // (bride/groom) is scoped to their own side plus "both", matching
    // functions/src/guests/authorization.ts's canViewGuest exactly.
    function canAccessGuestForEvent(eventId, guestSide) {
      let membershipPath = /databases/$(database)/documents/eventMembers/$(eventId + "_" + request.auth.uid);
      let membership = get(membershipPath).data;
      return membership.role in ["owner", "planner", "family", "staff", "viewer"] ||
        (membership.role == "couple" && membership.side == "bride" && guestSide in ["bride", "both"]) ||
        (membership.role == "couple" && membership.side == "groom" && guestSide in ["groom", "both"]);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile rules
    // users/{userId} — user can only read/write their own profile
    match /users/{userId} {
      allow read: if isOwnProfile(userId);

      allow create: if isOwnProfile(userId) && 
        request.resource.data.keys().hasOnly(['id', 'firstName', 'lastName', 'displayName', 'email', 'phone', 'avatarUrl', 'createdAt', 'updatedAt']) &&
        request.resource.data.id == userId &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        request.resource.data.displayName is string &&
        request.resource.data.email is string &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;

      allow update: if isOwnProfile(userId) &&
        request.resource.data.keys().hasOnly(['id', 'firstName', 'lastName', 'displayName', 'email', 'phone', 'avatarUrl', 'createdAt', 'updatedAt']) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Organization rules
    // organizations/{organizationId} — active organization membership required
    match /organizations/{organizationId} {
      allow read: if isActiveOrganizationMember(organizationId);

      // Deny all writes (organization management is server-side only)
      allow write: if false;
    }

    // Organization membership rules
    // organizationMembers/{membershipId} — user can read their own
    // memberships, and (for the Organization Members page) any membership
    // belonging to an organization they are themselves an active member
    // of. Mirrors eventMembers' identical widening.
    match /organizationMembers/{membershipId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isActiveOrganizationMember(resource.data.organizationId));

      // Deny all writes (membership creation/management is server-side only)
      allow write: if false;
    }

    // Event rules
    // events/{eventId} — active event membership required
    match /events/{eventId} {
      allow read: if isActiveEventMember(eventId);

      // Deny all writes (event management is server-side only)
      allow write: if false;
    }

    // Event membership rules
    // eventMembers/{membershipId} — user can read their own memberships, and
    // (for the People page) any membership belonging to an event they are
    // themselves an active member of.
    match /eventMembers/{membershipId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isActiveEventMember(resource.data.eventId));

      // Deny all writes (membership creation/management is server-side only)
      allow write: if false;
    }

    // Invitation rules
    // invitations/{invitationId} — the invitee (matched by their
    // authenticated email) may read their own invitation; any active member
    // of the event may read invitations for that event (People page).
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() &&
        (resource.data.invitedEmail == request.auth.token.email.lower() ||
         isActiveEventMember(resource.data.eventId));

      // Deny all writes (invitation creation/acceptance is server-side only,
      // via createInvitation / acceptInvitation Cloud Functions)
      allow write: if false;
    }

    // Organization invitation rules
    // organizationInvitations/{invitationId} — the invitee (matched by
    // their authenticated email) may read their own invitation; any active
    // member of the organization may read invitations for that
    // organization (Organization Members page). A deliberately separate
    // collection from `invitations` (event invitations) — organization
    // and event invitations are independent lifecycles, matching how
    // `organizationMembers`/`eventMembers` are already independent
    // collections rather than one shared membership model.
    match /organizationInvitations/{invitationId} {
      allow read: if isAuthenticated() &&
        (resource.data.invitedEmail == request.auth.token.email.lower() ||
         isActiveOrganizationMember(resource.data.organizationId));

      // Deny all writes (invitation creation/acceptance is server-side
      // only, via createOrganizationInvitation / acceptOrganizationInvitation
      // Cloud Functions)
      allow write: if false;
    }

    // Guest rules
    // guests/{guestId} — owner/planner/family/staff/viewer may view every
    // guest for their event; a couple member (bride/groom) only guests on
    // their own side plus "both" (see canAccessGuestForEvent above). Only
    // the trusted createGuest/updateGuest/deleteGuest Cloud Functions may
    // write, after independently re-verifying the same scope plus role
    // (owner/planner/couple — never family/staff/viewer). A flat
    // collection carrying an eventId field, like eventMembers/invitations —
    // not an events/{eventId}/guests subcollection.
    match /guests/{guestId} {
      allow read: if isActiveEventMember(resource.data.eventId) &&
        canAccessGuestForEvent(resource.data.eventId, resource.data.side);

      allow write: if false;
    }

    // Function/ceremony rules
    // functions/{functionId} — any active member of the event may view every
    // function for that event; there is no side-scoping for this domain
    // (unlike guests). Only the trusted createFunction/updateFunction/
    // deleteFunction Cloud Functions may write, after independently
    // re-verifying the caller has owner/planner authority. A flat
    // collection carrying an eventId field, like guests/eventMembers.
    match /functions/{functionId} {
      allow read: if isActiveEventMember(resource.data.eventId);

      allow write: if false;
    }

    // Expense rules
    // expenses/{expenseId} — any active member of the event may view every
    // expense for that event; there is no side-scoping for this domain
    // (matching functions/ceremonies). Only the trusted createExpense/
    // updateExpense/deleteExpense Cloud Functions may write, after
    // independently re-verifying the caller has owner/planner authority. A
    // flat collection carrying an eventId field, like guests/functions.
    match /expenses/{expenseId} {
      allow read: if isActiveEventMember(resource.data.eventId);

      allow write: if false;
    }

    // Vendor rules
    // vendors/{vendorId} — any active member of the event may view every
    // vendor for that event; there is no side-scoping for this domain
    // (matching functions/ceremonies/expenses). Only the trusted
    // createVendor/updateVendor/deleteVendor Cloud Functions may write,
    // after independently re-verifying the caller has owner/planner
    // authority. A flat collection carrying an eventId field, like
    // guests/functions/expenses.
    match /vendors/{vendorId} {
      allow read: if isActiveEventMember(resource.data.eventId);

      allow write: if false;
    }

    // Task rules
    // tasks/{taskId} — any active member of the event may view every task
    // for that event, regardless of role (owner/planner/staff/couple/
    // family/viewer all read the same list; who may *write* is what
    // differs — see functions/src/tasks/authorization.ts). Only the
    // trusted createTask/updateTask/deleteTask Cloud Functions may write.
    // A flat collection carrying an eventId field, like guests/functions/
    // expenses/vendors.
    match /tasks/{taskId} {
      allow read: if isActiveEventMember(resource.data.eventId);

      allow write: if false;
    }
  }
}
